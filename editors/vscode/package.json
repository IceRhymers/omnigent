{
  "name": "omnigent-vscode",
  "displayName": "Omnigent",
  "description": "Open Omnigent inside VS Code, in an editor-beside panel: your local server, or a remote one you sign in to.",
  "version": "0.1.0",
  "publisher": "databricks",
  "license": "Apache-2.0",
  "icon": "media/omnigent-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/omnigent-ai/omnigent.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "configuration": {
      "title": "Omnigent",
      "properties": {
        "omnigent.serverUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Omnigent server to open. Leave empty to auto-discover a locally running server, or set a localhost URL (e.g. `http://127.0.0.1:6767`) or a remote `https://` URL (e.g. `https://omnigent.example.com`). Remote servers load through a local proxy that signs you in. Use **Omnigent: Connect to Server…** to pick one."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "omnigent-container",
          "title": "Omnigent",
          "icon": "media/omnigent-icon.svg"
        }
      ]
    },
    "views": {
      "omnigent-container": [
        {
          "type": "tree",
          "id": "omnigent.home",
          "name": "Omnigent"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "omnigent.home",
        "contents": "Open Omnigent in an editor tab.\n[Open Omnigent](command:omnigent.open)\nStart a local server with `omnigent server`, or [connect to a remote server](command:omnigent.connect)."
      }
    ],
    "commands": [
      {
        "command": "omnigent.open",
        "title": "Omnigent: Open",
        "icon": "media/omnigent-icon.svg"
      },
      {
        "command": "omnigent.connect",
        "title": "Omnigent: Connect to Server…"
      },
      {
        "command": "omnigent.signOut",
        "title": "Omnigent: Sign Out of Server"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "omnigent.open",
          "group": "navigation@99"
        }
      ],
      "commandPalette": [
        {
          "command": "omnigent.open"
        },
        {
          "command": "omnigent.connect"
        },
        {
          "command": "omnigent.signOut"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.5",
    "vitest": "catalog:"
  }
}
